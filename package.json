{
  "name": "kmpw-api",
  "version": "1.6.0",
  "description": "API application for Keep My Paws Warm",
  "main": "dist/server.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dylan-Oleary/kmpw-api"
  },
  "author": "Dylan O'Leary <dylanolearydev@gmail.com>",
  "license": "MIT",
  "eslintConfig": {
    "extends": [
      "@theonlydevsever"
    ]
  },
  "prettier": "@theonlydevsever/prettier",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "scripts": {
    "build": "tsc",
    "build:clean": "rm -fr dist",
    "check:style": "concurrently -n Linter,Prettier -c magenta,green,blue \"yarn lint\" \"yarn prettier\"",
    "clean": "yarn build:clean && yarn docs:clean && yarn coverage:clean",
    "coverage:clean": "rm -fr coverage",
    "docs:build": "yarn docs:clean && yarn build && typedoc",
    "docs:clean": "rm -fr docs",
    "docs:rebuild": "typedoc",
    "dev": "export NODE_ENV=development && nodemon",
    "husky:commit": "yarn check:style && yarn test && yarn build",
    "husky:push": "yarn check:style && yarn test && yarn build",
    "lint": "eslint . && echo \"\n\nLint Complete - S'all Good Man!\n\n\" ",
    "prepare": "husky install",
    "prettier": "prettier --check \"./src/*\"",
    "prettier:fix": "prettier --write \"./src/*\"",
    "prisma:deploy": "npx prisma migrate deploy",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:reset": "npx prisma migrate reset",
    "prisma:seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "prisma:studio": "npx prisma studio",
    "start": "node -r ./buildPaths.js ./dist/server.js",
    "start:dev": "ts-node -r tsconfig-paths/register ./src/server.ts",
    "test": "jest --verbose",
    "test:coverage": "jest --verbose --coverage",
    "test:watch": "jest --verbose --watch"
  },
  "devDependencies": {
    "@theonlydevsever/eslint-config": "^1.0.2",
    "@theonlydevsever/prettier": "^1.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/convert-units": "^2.3.5",
    "@types/cookie-parser": "^1.4.2",
    "@types/express": "^4.17.13",
    "@types/extend": "^3.0.1",
    "@types/ioredis": "^4.28.5",
    "@types/jest": "^27.0.1",
    "@types/jsonwebtoken": "^8.5.6",
    "@types/ms": "^0.7.31",
    "@types/multer": "^1.4.7",
    "@types/node": "^16.9.1",
    "@typescript-eslint/eslint-plugin": "^4.31.0",
    "@typescript-eslint/parser": "^4.31.0",
    "chalk": "^4.1.2",
    "concurrently": "^6.2.1",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-html": "^6.1.2",
    "eslint-plugin-import": "^2.24.2",
    "eslint-plugin-jest": "^24.4.0",
    "eslint-plugin-jest-extended": "^0.0.1",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.25.1",
    "eslint-plugin-react-hooks": "^4.2.0",
    "husky": "^7.0.0",
    "jest": "^27.4.4",
    "jest-chain": "^1.1.5",
    "jest-extended": "^1.2.0",
    "nodemon": "^2.0.12",
    "prettier": "^2.4.0",
    "supertest": "^6.1.6",
    "ts-jest": "^27.0.5",
    "ts-node": "^10.4.0",
    "tsc": "^2.0.3",
    "typedoc": "^0.22.3",
    "typescript": "^4.4.3"
  },
  "dependencies": {
    "@graphql-tools/schema": "^8.3.1",
    "@prisma/client": "3.9.1",
    "@theonlydevsever/utilities": "^1.9.0",
    "apollo-server-express": "^3.5.0",
    "axios": "^0.24.0",
    "bcrypt": "^5.0.1",
    "cloudinary": "^1.30.1",
    "compression": "^1.7.4",
    "convert-units": "^2.3.4",
    "cookie-parser": "^1.4.6",
    "dotenv": "^10.0.0",
    "express": "^4.17.1",
    "extend": "^3.0.2",
    "geolib": "^3.3.3",
    "graphql": "^16.3.0",
    "graphql-scalars": "^1.17.0",
    "ioredis": "^4.28.2",
    "jsonwebtoken": "^8.5.1",
    "module-alias": "^2.2.2",
    "ms": "^2.1.3",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^3.1.30",
    "prisma": "^3.9.1",
    "tsconfig-paths": "^3.11.0"
  }
}
