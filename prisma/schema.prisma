// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model BreedGroup {
  id          String                       @id @default(uuid())
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  isDeleted   Boolean                      @default(false)
  name        String
  breeds      Breed[]
  description String?                      @db.Text
  attributes  DogAttributesOnBreedGroups[]
}

model Breed {
  id                String                  @id @default(uuid())
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  isDeleted         Boolean                 @default(false)
  name              String
  description       String?                 @db.Text
  altNames          String?
  countryCode       String?
  experimental      Boolean                 @default(false)
  hairless          Boolean                 @default(false)
  heightImperialMin Int
  heightImperialMax Int
  heightImperialAvg Int
  heightMetricMin   Int
  heightMetricMax   Int
  heightMetricAvg   Int
  hypoallergenic    Boolean                 @default(false)
  lifeSpanMin       Int
  lifeSpanMax       Int
  lifeSpanAvg       Int
  natural           Boolean                 @default(false)
  origin            String
  weightImperialMin Int
  weightImperialMax Int
  weightImperialAvg Int
  weightMetricMin   Int
  weightMetricMax   Int
  weightMetricAvg   Int
  wikipediaUrl      String?
  attributes        DogAttributesOnBreeds[]
  breedGroup        BreedGroup              @relation(fields: [breedGroupId], references: [id])
  breedGroupId      String
}

model DogAttribute {
  id                String                       @id @default(uuid())
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  isDeleted         Boolean                      @default(false)
  isGeneratedByUser Boolean                      @default(false)
  label             String
  value             String
  type              DogAttributeType
  breeds            DogAttributesOnBreeds[]
  breedGroups       DogAttributesOnBreedGroups[]
}

model DogAttributesOnBreeds {
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  isDeleted      Boolean      @default(false)
  breed          Breed        @relation(fields: [breedId], references: [id])
  breedId        String
  dogAttribute   DogAttribute @relation(fields: [dogAttributeId], references: [id])
  dogAttributeId String

  @@id([breedId, dogAttributeId])
}

model DogAttributesOnBreedGroups {
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  isDeleted      Boolean      @default(false)
  breedGroup     BreedGroup   @relation(fields: [breedGroupId], references: [id])
  breedGroupId   String
  dogAttribute   DogAttribute @relation(fields: [dogAttributeId], references: [id])
  dogAttributeId String

  @@id([breedGroupId, dogAttributeId])
}

enum DogAttributeType {
  BRED_FOR
  TEMPERAMENT
}
