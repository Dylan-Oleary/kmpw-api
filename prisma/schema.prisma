// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model BreedGroup {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)
  name        String   @unique
  description String?  @db.Text
  breeds      Breed[]
}

model Breed {
  id                String                  @id @default(uuid())
  dogApiId          Int                     @unique
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  isDeleted         Boolean                 @default(false)
  name              String                  @unique
  description       String?                 @db.Text
  altNames          String?
  countryCode       String?
  heightImperialMin Float?
  heightImperialMax Float?
  heightImperialAvg Float?
  heightMetricMin   Float?
  heightMetricMax   Float?
  heightMetricAvg   Float?
  lifeSpanMin       Float?
  lifeSpanMax       Float?
  lifeSpanAvg       Float?
  origin            String?
  weightImperialMin Float?
  weightImperialMax Float?
  weightImperialAvg Float?
  weightMetricMin   Float?
  weightMetricMax   Float?
  weightMetricAvg   Float?
  wikipediaUrl      String?
  attributes        DogAttributesOnBreeds[]
  breedGroup        BreedGroup              @relation(fields: [breedGroupId], references: [id])
  breedGroupId      String
  size              DogSize                 @relation(fields: [sizeId], references: [id])
  sizeId            String
}

model DogAttribute {
  id                String                  @id @default(uuid())
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  isDeleted         Boolean                 @default(false)
  isGeneratedByUser Boolean                 @default(false)
  label             String
  value             String
  type              DogAttributeType
  breeds            DogAttributesOnBreeds[]

  @@unique([type, value])
}

model DogAttributesOnBreeds {
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  isDeleted      Boolean      @default(false)
  breed          Breed        @relation(fields: [breedId], references: [id])
  breedId        String
  dogAttribute   DogAttribute @relation(fields: [dogAttributeId], references: [id])
  dogAttributeId String

  @@id([breedId, dogAttributeId])
}

model DogSize {
  id                          String      @id @default(uuid())
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  isDeleted                   Boolean     @default(false)
  weightClass                 WeightClass @unique
  weightImperialMin           Float
  weightImperialMax           Float
  weightImperialAvg           Float
  weightMetricMin             Float
  weightMetricMax             Float
  weightMetricAvg             Float
  levelOneDegreeRangeSize     Int
  levelTwoDegreeRangeSize     Int
  levelThreeDegreeRangeSize   Int
  noColdRiskFarenheitTemp     Int
  dangerColdRiskFarenheitTemp Int
  Breed                       Breed[]
}

model SafetyIndex {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
  level     Int      @unique
  message   String   @unique

  @@unique([level, message])
}

enum DogAttributeType {
  BRED_FOR
  TEMPERAMENT
}

enum WeightClass {
  SMALL
  MEDIUM
  LARGE
}
