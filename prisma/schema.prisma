// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model BreedGroup {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)
  name        String   @unique
  description String?  @db.Text
  breeds      Breed[]
}

model Breed {
  id                String                  @id @default(uuid())
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  isDeleted         Boolean                 @default(false)
  name              String                  @unique
  description       String?                 @db.Text
  dogApiId          Int?                    @unique
  altNames          String?
  countryCode       String?
  heightImperialMin Float?
  heightImperialMax Float?
  heightImperialAvg Float?
  heightMetricMin   Float?
  heightMetricMax   Float?
  heightMetricAvg   Float?
  lifeSpanMin       Float?
  lifeSpanMax       Float?
  lifeSpanAvg       Float?
  origin            String?
  source            BreedSource?
  weightImperialMin Float?
  weightImperialMax Float?
  weightImperialAvg Float?
  weightMetricMin   Float?
  weightMetricMax   Float?
  weightMetricAvg   Float?
  wikipediaUrl      String?
  attributes        DogAttributesOnBreeds[]
  breedGroup        BreedGroup              @relation(fields: [breedGroupId], references: [id])
  breedGroupId      String
  size              DogSize                 @relation(fields: [sizeId], references: [id])
  sizeId            String
  Dog               Dog[]
}

model Dog {
  id             String                @id @default(uuid())
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  isDeleted      Boolean               @default(false)
  name           String
  description    String?               @db.Text
  birthday       DateTime?
  profilePicture String?
  heightImperial Float?
  heightMetric   Float?
  weightImperial Float
  weightMetric   Float
  altNames       String?
  attributes     DogAttributesOnDogs[]
  breed          Breed                 @relation(fields: [breedId], references: [id])
  breedId        String
  size           DogSize               @relation(fields: [sizeId], references: [id])
  sizeId         String
  User           User?                 @relation(fields: [userId], references: [id])
  userId         String?
}

model DogAttribute {
  id                String                  @id @default(uuid())
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  isDeleted         Boolean                 @default(false)
  isGeneratedByUser Boolean                 @default(false)
  label             String
  value             String
  type              DogAttributeType
  breeds            DogAttributesOnBreeds[]
  dogs              DogAttributesOnDogs[]

  @@unique([type, value])
}

model DogAttributesOnBreeds {
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  isDeleted      Boolean      @default(false)
  breed          Breed        @relation(fields: [breedId], references: [id])
  breedId        String
  dogAttribute   DogAttribute @relation(fields: [dogAttributeId], references: [id])
  dogAttributeId String

  @@id([breedId, dogAttributeId])
}

model DogAttributesOnDogs {
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  isDeleted      Boolean      @default(false)
  dog            Dog          @relation(fields: [dogId], references: [id])
  dogId          String
  dogAttribute   DogAttribute @relation(fields: [dogAttributeId], references: [id])
  dogAttributeId String

  @@id([dogId, dogAttributeId])
}

model DogSize {
  id                                String      @id @default(uuid())
  createdAt                         DateTime    @default(now())
  updatedAt                         DateTime    @updatedAt
  isDeleted                         Boolean     @default(false)
  weightClass                       WeightClass @unique
  weightImperialMin                 Float
  weightImperialMax                 Float
  weightImperialAvg                 Float
  weightMetricMin                   Float
  weightMetricMax                   Float
  weightMetricAvg                   Float
  coldSafetyLevelOneFarenheitTemp   Int
  coldSafetyLevelTwoFarenheitTemp   Int
  coldSafetyLevelThreeFarenheitTemp Int
  coldSafetyLevelFourFarenheitTemp  Int
  coldSafetyLevelFiveFarenheitTemp  Int
  Breed                             Breed[]
  Dog                               Dog[]
}

model SafetyLevel {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)
  level     Int      @unique
  message   String   @unique

  @@unique([level, message])
}

model User {
  id                 String               @id @default(uuid())
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  reauthenticationAt DateTime?
  isDeleted          Boolean              @default(false)
  email              String               @unique
  password           String
  identityProvider   UserIdentityProvider
  dogs               Dog[]
}

enum UserIdentityProvider {
  LOCAL
}

enum DogAttributeType {
  BRED_FOR
  TEMPERAMENT
}

enum WeightClass {
  SMALL
  MEDIUM
  LARGE
}

enum BreedSource {
  CUSTOM
  DOG_API
}
