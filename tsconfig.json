{
  "compilerOptions": {
    "declaration": true,
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es2020",
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "./src",
    "baseUrl": "./src",
    "paths": {
      "errors/*": ["errors/*"],
      "gql/*": ["gql/*"],
      "lib/*": ["lib/*"],
      "middlewares/*": ["middlewares/*"],
      "root/*": ["*"],
      "routes/*": ["routes/*"],
      "services/*": ["services/*"],
      "types/*": ["types/*"]
    }
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["node_modules", "./src/**/__tests__/*"],
  "lib": ["esnext"]
}
